# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier .env ne doit JAMAIS etre versionne (voir .gitignore).

# --- Qdrant Cloud ---
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=colle_ta_cle_qdrant_ici

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=colle_ta_cle_gemini_ici

# --- Parametres du projet ---
QDRANT_COLLECTION=previa_comportements
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
